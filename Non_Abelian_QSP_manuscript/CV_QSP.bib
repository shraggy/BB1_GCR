	url = {http://arxiv.org/abs/2412.03650},
	doi = {},
	abstract = {We propose a simple circuit architecture for a dissipatively error corrected Gottesman-Kitaev-Preskill (GKP) qubit. The device consists of a electromagnetic resonator with impedance \$h/2e{\textasciicircum}2{\textbackslash}approx 12.91{\textbackslash},\{{\textbackslash}rm k\}{\textbackslash}Omega\$ connected to a Josephson junction with a voltage bias oscillating at twice the resonator frequency. For large drive amplitudes, the circuit is effectively described by the GKP stabilizer Hamiltonian, whose low-energy subspace forms the code space for a qubit protected against phase-space local noise. The GKP states in the codespace can be dissipatively stabilized and error corrected by coupling the resonator to a bath through a bandpass filter; a resulting side-band cooling effect stabilizes the system in the GKP code space, dissipatively correcting it against both bit and phase flip errors. Simulations show that this dissipative error correction can enhance coherence time by factor \${\textbackslash}sim 1000\$ with NbN-based junctions, for operating temperatures in the \${\textbackslash}sim 100{\textbackslash},\{{\textbackslash}rm mK\}\$ range. The scheme can be used to stabilize both square- and hexagonal-lattice GKP codes. Finally, a Josephson current based readout scheme, and dissipatively corrected single-qubit Clifford gates are proposed.},
	urldate = {2025-03-25},
	publisher = {arXiv},
	author = {Geier, Max and Nathan, Frederik},
	month = dec,
	year = {2024},
	note = {arXiv:2412.03650 [quant-ph]},
	keywords = {Condensed Matter - Mesoscale and Nanoscale Physics, Condensed Matter - Superconductivity, Quantum Physics},
	annote = {Comment: 10+8 pages, 5+3 figures},
